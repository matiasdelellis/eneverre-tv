<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ backup/transfer rules. Keep the auth prefs (access + refresh
   tokens) out of both the cloud backup and direct device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.xml" />
    </device-transfer>
</data-extraction-rules>
